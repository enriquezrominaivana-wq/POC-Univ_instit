# Copiar este archivo como ".env" y completar con los datos del proyecto Supabase.
# La app usa SIEMPRE la clave pública (anon key / publishable key) + RLS de solo lectura.
# Si faltan las variables, la aplicación funciona con el dataset local (fallback).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: nombre exacto de la tabla (por defecto: instituciones)
VITE_SUPABASE_TABLE=instituciones
